# Resend API key: server-side only. Never commit a real key.
RESEND_API_KEY=
# Optional override of the test recipient (defaults to the address below).
CONTACT_TO_EMAIL=timdessaigne@gmail.com
# Pre-launch indexing is locked in src/lib/indexing.ts until publication approval.
# Even a previous true value cannot bypass the lock. Rebuild after release changes.
SITE_INDEXABLE=false
# Sanity project with a public dataset (published documents only).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
